{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Alfa Remote Client",
  "version": "0.9.2",
  "identifier": "com.alfa.remoteclient",
  "build": {
    "frontendDist": "../dist-renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vue",
    "beforeBuildCommand": "npm run build:vue"
  },
  "app": {
    "windows": [
      {
        "title": "Alfa Remote Client",
        "width": 1100,
        "height": 880,
        "minWidth": 1200,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://10.230.121.212/electron/latest/"],
      "pubkey": ""
    }
  }
}
