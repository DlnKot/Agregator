  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.4.0",
    "vite": "^8.0.0",
    "vue": "^3.5.30",
    "vue-eslint-parser": "^10.2.0"
  }
}
