{
  "name": "alfa-remote-client",
  "version": "0.9.3",
  "description": "Alfa Remote Client - агрегатор для запуска клиентов удалённых рабочих столов (RDP, Horizon, Citrix)",
  "scripts": {
    "prebuild:vue": "node scripts/sync-version.js",
    "build:vue": "vite build",
    "dev:vue": "vite --port 5173",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "tauri build",
    "lint": "eslint .",
    "test": "node --test"
